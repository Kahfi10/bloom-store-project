{
  "name": "bloom-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:bdd": "cross-env TS_NODE_PROJECT=tsconfig.cucumber.json cucumber-js",
    "test:bdd:report": "cross-env TS_NODE_PROJECT=tsconfig.cucumber.json cucumber-js --format html:cucumber-report.html",
    "test:e2e": "cypress open",
    "test:e2e:run": "cypress run",
    "test:e2e:ui": "cypress run --spec 'cypress/e2e/login.cy.ts,cypress/e2e/products.cy.ts'",
    "test:e2e:api": "cypress run --spec 'cypress/e2e/api.cy.ts'",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "gsap": "^3.15.0",
    "next": "16.2.11",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "cypress": "^15.19.0",
    "jest": "^30.4.2",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
